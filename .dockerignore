# NOTE: this file stays at the repo root even though the Dockerfile lives in
# docker/. Docker resolves .dockerignore against the BUILD CONTEXT, which is
# the repo root for both entry points (`docker compose` from docker/ sets
# `context: ..`, and the documented single-container build passes `.`). Moving
# it into docker/ would make the classic builder silently ignore it and ship a
# multi-GB context.
#
# Build artifacts — never copied into the image. Keeps `docker build`
# context small (the Rust target dir is several GB on a warm checkout).
target/
**/target/

# IDE / editor scratch
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Local secrets and per-user config that should never bake into an image
.env
.env.local
*.token
secrets/

# OS junk
.DS_Store
Thumbs.db

# Anything not needed at build time
docs/
launch-drafts/
runs/
target/package/
.github/
docker/
CHANGELOG.md
README.md
PRIVACY.md
install.sh
install.ps1
